<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.vulkan.version" android:required="false"/>

    <!--
      Shared storage. Android 11+ (targetSdk 30+) gates raw /sdcard paths
      behind MANAGE_EXTERNAL_STORAGE, "All files access": a per-app toggle
      in system settings that MainActivity.requestStoragePermissions opens
      once on first launch and Settings > Android opens again.
      READ/WRITE_EXTERNAL_STORAGE stay for Android 8 to 10, where they are
      the runtime-prompted grants; requestLegacyExternalStorage keeps raw
      paths on Android 10 and preserveLegacyExternalStorage keeps them
      across the upgrade from the targetSdk 28 releases on Android 11.
      Projects under the app files dir need none of this.
    -->
    <!-- Required for any HTTP/HTTPS: Zed's HTTP client and every tool in
         the rootfs (apt, curl, git, npm). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29"/>
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
    <!-- Required for the in-app updater's package installer session. The
         user still has to grant "Install unknown apps" for this package in
         system settings the first time. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- Runtime foreground service (ZdRuntimeService). FOREGROUND_SERVICE
         is required from API 28; FOREGROUND_SERVICE_SPECIAL_USE is checked
         from targetSdk 34 and declared ahead of that bump; WAKE_LOCK backs
         the optional keep-awake lock; REQUEST_IGNORE_BATTERY_OPTIMIZATIONS
         lets the app open the exemption dialog; POST_NOTIFICATIONS is the
         service notification on Android 13+ (the service runs without it,
         the notification is just hidden). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!--
      Backups are off because the home directory holds credentials, such
      as ~/.ssh keys and git tokens, which `adb backup` and cloud or
      device-to-device backups would otherwise copy off the device.
      allowBackup covers Android 11 and earlier; from Android 12,
      dataExtractionRules does, since allowBackup no longer stops
      device-to-device transfers for apps targeting it.
    -->
    <application
        android:name=".ZedApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="Zdroid"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Zdroid.Splash"
        android:hasCode="true"
        android:appCategory="productivity"
        android:requestLegacyExternalStorage="true"
        android:preserveLegacyExternalStorage="true"
        android:resizeableActivity="true">

        <!--
          Lets `adb shell` profile release builds with simpleperf or
          Perfetto on Android 10 and later, as Google recommends for
          measuring the builds people run. It doesn't make the app
          debuggable: no debugger and no run-as. See "Debugging on the
          tablet" in FORK.md.
        -->
        <profileable android:shell="true" />

        <!--
          Exhaustive configChanges: in freeform / desktop windowing mode every
          drag-resize fires a config change, which by default destroys+recreates
          the Activity (breaking our gpui Window mid-resize). Declaring every
          relevant config tells the OS to deliver onConfigurationChanged()
          instead. density+colorMode handle cross-display moves; fontScale +
          fontWeightAdjustment handle accessibility setting changes;
          layoutDirection handles RTL toggle; grammaticalGender handles the
          "Terms of address" language setting. A recreation would end the app:
          MainActivity.onDestroy exits the process because gpui can't restart
          in it. Verbose but cheap.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Zdroid.Splash"
            android:windowLayoutInDisplayCutoutMode="always"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode|colorMode|fontScale|fontWeightAdjustment|layoutDirection|locale|mcc|mnc|touchscreen|grammaticalGender"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden">
            <meta-data
                android:name="android.app.lib_name"
                android:value="zed_android"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!--
          Each cx.open_window beyond the primary spawns one of these.
          documentLaunchMode="always" implies FLAG_ACTIVITY_NEW_DOCUMENT |
          FLAG_ACTIVITY_MULTIPLE_TASK, so each open is a fresh task with its
          own Recents card and (in freeform mode) its own OS-chromed window.
          Document tasks stay in Recents after their Activity finishes unless
          autoRemoveFromRecents is set: windows closed with Back or the OS
          chrome X otherwise left empty cards in One UI's Recents.
          taskAffinity differentiates from MainActivity's task. exported=false
          because only our own Rust code launches it (via JNI Intent).
        -->
        <activity
            android:name=".ExtraWindowActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:documentLaunchMode="always"
            android:autoRemoveFromRecents="true"
            android:taskAffinity="com.zdroid.extra"
            android:windowLayoutInDisplayCutoutMode="always"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode|colorMode|fontScale|fontWeightAdjustment|layoutDirection|locale|mcc|mnc|touchscreen|grammaticalGender"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden"/>

        <!--
          Exposes Zed's home dir as a SAF root so other apps can browse
          / share files from `~` via the system DocumentsUI picker. Same
          pattern Termux uses. `android.permission.MANAGE_DOCUMENTS` is
          system-only — only the system's DocumentsUI can talk to us
          directly; user-level apps reach our root by selecting it in the
          picker. `grantUriPermissions=true` lets the picker hand a
          time-limited URI grant to whatever app the user picks the file
          for.
        -->
        <provider
            android:name=".ZedDocumentsProvider"
            android:authorities="com.zdroid.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER"/>
            </intent-filter>
        </provider>

        <!-- The in-app updater's install session reports here, and so does
             MY_PACKAGE_REPLACED once the update has installed. -->
        <receiver
            android:name=".UpdateInstallReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>

        <!--
          Holds the process out of the cached state while language servers
          or terminal shells are running, so Android's phantom process
          killer leaves them alone, and while Keep Running in Background
          is on. Rust reports the process tree
          (gpui_android::runtime_service); see
          docs/workarounds/runtime-foreground-service.md.
        -->
        <service
            android:name=".ZdRuntimeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the editor's language servers, terminal shells and agent sessions running while the app is in the background"/>
        </service>
    </application>
</manifest>
